/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://engine.aelio.live https://*.googleapis.com https://securetoken.googleapis.com https://identitytoolkit.googleapis.com; frame-src https://aelio-0820.firebaseapp.com https://accounts.google.com; base-uri 'self'; form-action 'self'

/brain/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/studiobrain/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/_src/*
  X-Robots-Tag: noindex
