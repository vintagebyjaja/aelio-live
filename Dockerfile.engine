# syntax=docker/dockerfile:1
FROM python:3.12-slim
WORKDIR /app
COPY engine/requirements.txt ./requirements.txt
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then PIP_CERT=/run/secrets/proxy_ca pip install --no-cache-dir -r requirements.txt; else pip install --no-cache-dir -r requirements.txt; fi
COPY engine/ ./
RUN chmod -R a+rX /app
ENV AELIO_AUTH=supabase AELIO_DATABASE=postgres AELIO_PAID_PLANS_OPEN=0 AELIO_DATA_DIR=/tmp/aelio-runtime
ENV PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8787
CMD ["python", "-m", "aelio.cli", "serve", "--host", "0.0.0.0", "--port", "8787"]
