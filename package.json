{
  "name": "aelio-live",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node _src/build-auth-config.mjs && node _src/build.mjs && node _src/build-brain.mjs && node _src/build-chat.mjs",
    "build:pages": "node _src/build.mjs",
    "build:brain": "node _src/build-brain.mjs",
    "check": "node _src/checks/check-public.mjs",
    "check:deploy": "node _src/checks/check-deploy.mjs",
    "test": "node --test _src/checks/test-engine-proxy.mjs _src/checks/test-supabase-auth.mjs _src/checks/test-pathd-bridge.mjs _src/checks/test-worker.mjs _src/checks/test-platform.mjs _src/checks/test-appearance.mjs _src/checks/test-auth-config.mjs _src/checks/test-openai.mjs _src/checks/test-experience.mjs _src/checks/test-recovery-optional.mjs _src/checks/test-groups.mjs _src/checks/test-workspaces.mjs _src/checks/test-router.mjs _src/checks/test-billing.mjs _src/checks/test-studio-access.mjs _src/checks/test-aurevia.mjs",
    "dev": "node _src/checks/pages-emulator.mjs public 8090",
    "build:chat": "node _src/build-chat.mjs",
    "typecheck": "tsc --noEmit -p _src",
    "build:auth": "node _src/build-auth-config.mjs"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "esbuild": "0.25.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3"
  },
  "version": "1.0.11",
  "dependencies": {
    "@supabase/auth-js": "^2.118.0",
    "three": "0.180.0"
  }
}
