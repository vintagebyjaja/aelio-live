# Client-safe public build/runtime values. Existing shared project only.
NEXT_PUBLIC_SUPABASE_URL=https://xkpzabgpesishxcluxkp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_public_publishable_key
# Legacy client-safe alternative: NEXT_PUBLIC_SUPABASE_ANON_KEY
# Server-only Worker runtime secrets; never put these under NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_in_worker_runtime_secrets_only
OPENAI_API_KEY=replace_in_worker_runtime_secrets_only
# Optional existing provider controls. No new engine or storage infrastructure.
AELIO_AI_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
# Keep passkeys OFF until native hosted Auth/RP/origin/recent-auth policy is verified.
AELIO_PASSKEYS_ENABLED=false
# PATHD's separate build flag; not an AELIO setting.
# NEXT_PUBLIC_ENABLE_PASSKEYS=false
