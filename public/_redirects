# Short addresses (everything stays on aelio.live)
/login                /brain/                    302
/my-aelio             /brain/my/                 301
/my-aelio/*           /brain/my/:splat           301
/studio               /studiobrain/              301
/studio/*             /studiobrain/:splat        301
/backoffice           /studiobrain/engine        301
/settings/security    /brain/my/security         301
# Old one-page anchors -> new pages
/#aelio          /aelio/                   301
