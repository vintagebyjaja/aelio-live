rules_version = '2';
// AELIO Studio: founder-only Cloud Storage rules (datasets, checkpoints, audio).
service firebase.storage {
  match /b/{bucket}/o {
    function isFounder() {
      return request.auth != null
        && request.auth.uid == '0RcUhRBDI4hGWisgzuyezqGVVZC3'
        && request.auth.token.email == 'jaja@vybr8.live'
        && request.auth.token.email_verified == true;
    }
    match /{allPaths=**} {
      allow read, write: if isFounder();
    }
  }
}
