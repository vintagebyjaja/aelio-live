// aelio.live on Cloudflare Workers (static assets + a small Worker for /api and Brain deep links).
// Deploy: npx wrangler deploy --config wrangler.jsonc   (only ./public is uploaded as assets; nothing else is published)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aelio-live",
  "keep_vars": true,
  "main": "_src/edge/worker.js",
  "build": {"command":"node _src/build-auth-config.mjs"},
  "compatibility_date": "2026-10-23",
  // Add the private AELIO_ENGINE service binding only after aelio-engine exists.
  // See config/CONNECT_BRAIN.md; missing targets cause Cloudflare error 10143.
  "r2_buckets": [{ "binding": "AELIO_STORAGE", "bucket_name": "aelio-storage" }],
  "vars": { "SUPABASE_URL": "https://xkpzabgpesishxcluxkp.supabase.co" },
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths run the Worker; every other request is a plain static file.
    "run_worker_first": true
  }
  // When the private engine Worker exists (cloudflare/aelio-engine-worker), connect it here, then add the secret:
  //   "services": [{ "binding": "AELIO_ENGINE", "service": "aelio-engine" }]
  //   npx wrangler secret put AELIO_PROXY_SECRET
  // Until then /api answers 503 "engine not connected" and the public site works normally.
}
